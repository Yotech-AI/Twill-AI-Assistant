{
  "name": "yotech-ai/twill-cms-ai-assistant",
  "description": "An AI content assistant and MCP connector for Twill CMS.",
  "keywords": ["twill", "laravel", "cms", "ai", "mcp", "twill-plugin"],
  "homepage": "https://github.com/Yotech-AI/Twill-AI-Assistant",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": "^8.3",
    "illuminate/support": "^12.0 || ^13.0",
    "area17/twill": "^3.5",
    "laravel/ai": "^0.3.2"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "laravel/pint": "^1.24",
    "laravel/mcp": "^0.9",
    "laravel/passport": "^13.7.1",
    "phpoffice/phpword": "^1.4",
    "yotech-ai/twill-cms-seo-suite": "^1.0"
  },
  "suggest": {
    "laravel/mcp": "Required for the MCP connector (^0.5.9 || ^0.9).",
    "laravel/passport": "Required for the MCP connector's OAuth 2.1 flow (^13.7.1 — 13.7.0 and below carry CVE-2026-39976 in the token guard).",
    "phpoffice/phpword": "Required to read .docx chat attachments (^1.4)."
  },
  "autoload": {
    "psr-4": {
      "TwillAi\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TwillAi\\Tests\\": "tests"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "TwillAi\\TwillAiServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
