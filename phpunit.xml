<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <!-- Deliberately non-overlapping: PHPUnit warns when one file belongs to
             two suites, and failOnWarning turns that into a failed run. The
             connector suite is separate so CI can run everything except Mcp for
             a host that installed neither laravel/mcp nor laravel/passport. -->
        <testsuite name="Package">
            <directory>tests/Feature/Package</directory>
        </testsuite>
        <testsuite name="TwillAi">
            <directory>tests/Feature/TwillAi</directory>
        </testsuite>
        <testsuite name="Mcp">
            <directory>tests/Feature/Mcp</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
    </php>
</phpunit>
