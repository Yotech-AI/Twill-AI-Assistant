# Keep development-only files out of the dist archive Composer downloads.
# A host installing this package gets src/, config/, routes/, resources/,
# database/ and the docs it might actually read — not the test suite, the
# fixture CMS or the CI workflow.
/.github            export-ignore
/tests              export-ignore
/docs/session-handoff.md export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml        export-ignore

# Normalise line endings so a Windows checkout does not commit CRLF.
* text=auto eol=lf
*.png binary
*.jpg binary
*.woff2 binary
